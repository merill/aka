---
/**
 * Searchable category picker, shared by the homepage filter and the /add form.
 *
 * Written once rather than twice: the two differ only in their "no category"
 * label, whether they show counts, and whether a value is required. Behaviour
 * lives in category-combobox.js.
 *
 * Renders a button plus a listbox rather than a <select> so it can show an icon
 * per option and filter as you type — a plain select could do neither, and the
 * shared taxonomy has 29 entries.
 */
export interface Option {
  value: string;
  label: string;
  iconUrl?: string;
  count?: number;
  /** Extra search terms, e.g. "aad" finding Entra. */
  keywords?: string;
  /** Curated groups sort above the long tail of products. */
  common?: boolean;
}

export interface Props {
  /** Base id; child elements derive theirs from it. */
  id: string;
  options: Option[];
  /** Label for the empty choice, e.g. "All categories". */
  emptyLabel: string;
  /** Count shown against the empty choice, when counts are in use. */
  emptyCount?: number;
  /** Name for the hidden input, when inside a form. */
  name?: string;
  value?: string;
  minWidth?: string;
}

const {
  id,
  options,
  emptyLabel,
  emptyCount,
  name,
  value = '',
  minWidth = '11rem',
} = Astro.props;

const ICON_BASE = 'https://getyako.com/ms/';
const selected = options.find((o) => o.value === value);
---

<div class="relative" id={`${id}-combo`} data-category-combobox>
  <button
    type="button"
    id={`${id}-button`}
    class="flex w-full items-center justify-between gap-2 rounded border px-3 py-2 text-sm"
    style={`border-color: var(--aka-border); background: var(--aka-bg); color: var(--aka-fg); min-width: ${minWidth};`}
    aria-haspopup="listbox"
    aria-expanded="false"
    aria-controls={`${id}-menu`}
  >
    <span class="flex min-w-0 items-center gap-2">
      <span
        id={`${id}-icon`}
        class={selected?.iconUrl ? 'aka-icon' : 'aka-icon hidden'}
        style={selected?.iconUrl
          ? `width:16px;height:16px;background-image:url('${selected.iconUrl}')`
          : 'width:16px;height:16px;'}
        aria-hidden="true"></span>
      <span class="truncate" id={`${id}-label`}>{selected?.label ?? emptyLabel}</span>
    </span>
    <span aria-hidden="true" style="color: var(--aka-muted);">▾</span>
  </button>

  <input type="hidden" id={id} name={name} value={value} />

  <div
    id={`${id}-menu`}
    class="absolute left-0 z-50 mt-1 hidden w-72 rounded border shadow-lg"
    style="border-color: var(--aka-border); background: var(--aka-bg);"
  >
    <div class="border-b p-2" style="border-color: var(--aka-border);">
      <label class="sr-only" for={`${id}-search`}>Search categories</label>
      <input
        id={`${id}-search`}
        type="text"
        autocomplete="off"
        placeholder="Search categories…"
        class="w-full rounded border px-2 py-1.5 text-sm"
        style="border-color: var(--aka-border); background: var(--aka-bg); color: var(--aka-fg);"
      />
    </div>

    {/* Options are rendered by the client from the payload below rather than
        as markup. The taxonomy has ~700 entries, and emitting them all
        server-side pushed this page from 9 KB to 514 KB of HTML. Only matches
        are materialised, capped, so the DOM stays small however long the list
        gets. */}
    <ul
      id={`${id}-list`}
      role="listbox"
      aria-labelledby={`${id}-button`}
      class="m-0 max-h-72 list-none overflow-y-auto p-1"
    ></ul>

    <script
      type="application/json"
      id={`${id}-data`}
      set:html={JSON.stringify({
        emptyLabel,
        emptyCount,
        // Icon URLs share one long prefix; storing it once saves ~16 KB across
        // ~700 options. The client puts it back.
        iconBase: ICON_BASE,
        options: options.map((o) => {
          const entry: Record<string, unknown> = { v: o.value, l: o.label };
          const icon = o.iconUrl ?? '';
          if (icon) entry.i = icon.startsWith(ICON_BASE) ? icon.slice(ICON_BASE.length) : icon;
          if (o.count !== undefined) entry.c = o.count;
          if (o.keywords) entry.k = o.keywords;
          if (o.common) entry.g = 1;
          return entry;
        }),
      })}
    />

    <p
      id={`${id}-empty`}
      class="m-0 hidden px-3 py-4 text-center text-sm"
      style="color: var(--aka-muted);"
    >
      No categories found.
    </p>
  </div>
</div>
